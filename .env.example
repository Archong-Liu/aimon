# 複製成 .env 後填入金鑰： cp .env.example .env
# 取得金鑰： https://aistudio.google.com/apikey
# 注意：金鑰只放 .env（已 gitignore），不要填在這支範本檔，它是會進版控的。
GEMINI_API_KEY=

# 預設模型。用 -latest alias，Google 下架舊版號時不會突然壞掉。
# 免費方案通常沒有 pro 系列配額（會回 429），先用 flash。
GEMINI_MODEL=gemini-flash-latest

PORT=5173

# 資料夾位置（相對於專案根目錄）
DATA_DIR=data
RUNS_DIR=runs

# 送進模型的內容上限，文件很大時可調高
MAX_FILE_CHARS=60000
MAX_TOTAL_CHARS=400000
MAX_BINARY_BYTES=12582912
